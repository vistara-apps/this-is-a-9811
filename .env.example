# Pocket Protector Environment Configuration
# Copy this file to .env.local and fill in your API keys

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Airstack API Configuration (Optional)
VITE_AIRSTACK_API_KEY=your_airstack_api_key_here

# Backend API Configuration
VITE_BACKEND_URL=http://localhost:3001

# Application Configuration
VITE_APP_NAME=Pocket Protector
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CRASH_REPORTING=false
VITE_ENABLE_BETA_FEATURES=false

# Security Configuration
VITE_ENABLE_ENCRYPTION=true
VITE_ENABLE_AUDIT_LOGGING=true

# Legal Network Configuration
VITE_LEGAL_NETWORK_ENABLED=true
VITE_EMERGENCY_CONTACT_ENABLED=true
